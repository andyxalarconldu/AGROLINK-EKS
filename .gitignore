# ==========================================================
# .gitignore
# Lista de archivos que Git NO debe subir al repositorio.
# ==========================================================

# ---------- TERRAFORM ----------
# Carpeta con plugins descargados (pesa cientos de MB y se regenera con "init")
.terraform/

# Estado local y sus copias: contienen datos sensibles (ej. contraseña de la BD)
*.tfstate
*.tfstate.*

# Plan guardado: puede contener secretos
*.tfplan
tfplan

# Variables con valores reales (pueden tener secretos)
*.tfvars
*.tfvars.json

# Logs de fallos
crash.log
crash.*.log

# OJO: NO ignores ".terraform.lock.hcl".
# Debe subirse: es la prueba de "versiones de proveedor fijadas".

# ---------- CREDENCIALES Y SECRETOS ----------
# Nunca subir llaves de AWS ni archivos de secretos
.aws/
credentials
*.pem
*.key
.env
.env.*
secret*.yaml
secrets/

# ---------- PYTHON ----------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
.pytest_cache/

# ---------- DOCKER ----------
*.tar

# ---------- EDITOR Y SISTEMA ----------
.vscode/
.idea/
.DS_Store
Thumbs.db